# apps/company 환경 변수 (전부 NEXT_PUBLIC_* — 빌드 타임에 정적 HTML 에 인라인된다.
# 비밀값은 절대 넣지 말 것. 미설정 시 config/site.ts 의 기본값(vercel.app)이 쓰인다.)

# 회사 소개 사이트 자신의 절대 URL — canonical·OG·sitemap·robots 기준
NEXT_PUBLIC_COMPANY_URL=https://duckmate-company.vercel.app

# 서비스 본체(apps/web) 절대 URL — "시작하기" CTA, 약관 6종 링크 대상
NEXT_PUBLIC_WEB_URL=https://duckmate-web.vercel.app

# 문의 폼 전송 엔드포인트 (Supabase Edge Function `company-contact`).
# 미설정이면 폼은 mailto 폴백 모드로 동작한다 (26_fe_company.md §3).
# NEXT_PUBLIC_CONTACT_ENDPOINT=https://<project-ref>.supabase.co/functions/v1/company-contact
