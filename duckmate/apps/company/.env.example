# apps/company — 정적 export. 전부 빌드 시 인라인되는 공개 값(비밀 금지).
# company 사이트 자기 URL (metadataBase·sitemap·robots). 미설정 시 http://localhost:3001
NEXT_PUBLIC_COMPANY_URL=
# 앱(apps/web) URL — 헤더/히어로 CTA(/onboarding/age), 법적 고지 canonical. 미설정 시 CTA "준비 중"
NEXT_PUBLIC_WEB_APP_URL=
# 문의 Edge Function URL (예: https://<ref>.supabase.co/functions/v1/contact). 미설정 시 폼은 오류 상태 + mailto 폴백
NEXT_PUBLIC_CONTACT_ENDPOINT=
# Vercel 이 자동 주입. production 이 아니면 메타 noindex
# VERCEL_ENV=
