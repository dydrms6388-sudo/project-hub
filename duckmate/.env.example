# ── Supabase (프로덕션 값은 Vercel/Supabase 대시보드에만 저장, 커밋 금지) ──
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ── 사이트 ──
NEXT_PUBLIC_SITE_URL=https://duckmate.example.com
NEXT_PUBLIC_COMPANY_SITE_URL=https://company.duckmate.example.com

# ── 본인인증 (포트원) — Phase 1은 어댑터 인터페이스만, 실키는 배포 후 ──
# IDENTITY_VERIFIER: 비우면 PortOne(실연동). "stub" 은 개발/E2E 전용이며
#   실 프로덕션(NODE_ENV=production 이고 VERCEL_ENV=production)에서는 런타임이
#   에러로 차단한다 — 만 19세 확인이 무효화되기 때문 (보안 리뷰 G2-01).
IDENTITY_VERIFIER=
# 스토어 심사용 바이패스 계정(쉼표 구분). 프로덕션에서도 stub 경로를 타지만
#   birth_date 는 덮어쓰지 않으며 audit_logs 에 bypass=true 로 남는다.
REVIEW_BYPASS_EMAILS=
PORTONE_API_KEY=
PORTONE_API_SECRET=
PORTONE_STORE_ID=

# ── 결제 (Toss Payments) — Phase 3 ──
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
TOSS_WEBHOOK_SECRET=

# ── Web Push (VAPID) ──
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@example.com
