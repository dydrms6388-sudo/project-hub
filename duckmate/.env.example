# ── Supabase (프로덕션 값은 Vercel/Supabase 대시보드에만 저장, 커밋 금지) ──
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ── 사이트 ──
NEXT_PUBLIC_SITE_URL=https://duckmate.example.com
NEXT_PUBLIC_COMPANY_SITE_URL=https://company.duckmate.example.com

# ── 본인인증 (포트원) — Phase 1은 어댑터 인터페이스만, 실키는 배포 후 ──
PORTONE_API_KEY=
PORTONE_API_SECRET=
PORTONE_STORE_ID=

# ── 결제 (Toss Payments) — Phase 3 ──
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
TOSS_WEBHOOK_SECRET=

# ── Web Push (VAPID) ──
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@example.com
