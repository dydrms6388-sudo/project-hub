# ---- Supabase (apps/web) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # 서버 전용. 클라이언트 번들 금지 (lib/supabase/admin.ts 만 읽음, server-only)
# ---- Web Push ----
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# ---- 본인인증(PortOne) — Phase 4 실연동, Phase 1은 mock 어댑터 ----
PORTONE_API_KEY=
PORTONE_API_SECRET=
PORTONE_WEBHOOK_SECRET=               # Edge Function identity-webhook (Supabase secrets 에 설정)
IDENTITY_VERIFIER=mock                # mock | portone
IDENTITY_MOCK_ALLOWLIST=              # 프로덕션 mock 통과 목록: sha256(휴대폰 E.164 숫자만, 예 821012345678) hex, 쉼표 구분. 비우면 전원 실패
IDENTITY_CI_SALT=                     # sha256(CI + salt). 32바이트 이상 무작위. 회전 금지(기존 ci_hash 무효화)
# ---- 해시 솔트 (D2) ----
PHONE_HASH_SALT=                      # profiles.phone_hash = sha256(E.164 숫자 + salt). IDENTITY_CI_SALT 와 분리
CONSENT_HASH_SALT=                    # consents.ip_hash / ua_hash
AUTH_GATE_SECRET=                     # 미들웨어 게이트 캐시 쿠키 HMAC 키(선택). 없으면 SUPABASE_SERVICE_ROLE_KEY 로 대체
# ---- Edge Function photo-review (Supabase secrets) ----
# FACE_API_URL=                       # 얼굴 검사 외부 API(https). 없으면 detector=none(사람 검수 대기)
# FACE_API_KEY=
# PHOTO_REVIEW_WEBHOOK_SECRET=        # Storage 웹훅 → photo-review 호출 시 x-webhook-secret
# ---- 결제(Toss) — Phase 3 ----
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
TOSS_WEBHOOK_SECRET=
# ---- 사이트 ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_COMPANY_URL=http://localhost:3001
