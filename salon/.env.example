# Supabase (프로젝트 설정 → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel 크론 인증 (아무 랜덤 문자열, Vercel이 Authorization: Bearer로 자동 첨부)
# 미설정 시 크론 엔드포인트는 503으로 요청을 거부한다 (열린 엔드포인트 방지)
CRON_SECRET=

# 솔라피 (친구 계정에서 발급, Vercel 환경변수에 직접 입력)
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
# 카카오 비즈니스 채널 발신프로필 ID
KAKAO_PFID=
# 심사 통과한 알림톡 템플릿 ID
ALIMTALK_TEMPLATE_BOOKING_CONFIRM=
ALIMTALK_TEMPLATE_REVIEW_REQUEST=
ALIMTALK_TEMPLATE_TOUCHUP_REMINDER=
# Phase 1.5 — 채우는 순간 winback 크론이 집계 모드에서 발송 모드로 전환된다
ALIMTALK_TEMPLATE_WINBACK=

# 템플릿 버튼/본문에 들어가는 링크
REVIEW_LINK=
BOOKING_LINK=

# ── Phase 2 콘텐츠 초안 생성 (GitHub Actions 전용) ──
# 리포 Settings → Secrets → Actions 에 넣는다. Vercel 환경변수에는 넣지 않는다
# (앱 런타임은 이 키를 쓰지 않는다). 로컬에서 수동 생성할 때만 여기에 둔다.
ANTHROPIC_API_KEY=
