# ---------------------------------------------------------------------------
# BETWEEN 환경변수. 로컬 개발은 이 파일을 .env.local 로 복사하면 바로 동작한다.
# 비밀값은 절대 커밋하지 말 것.
# ---------------------------------------------------------------------------

# 공개 origin (CSRF Origin 검사, 절대 URL 생성)
APP_ORIGIN=http://localhost:3000

# Postgres 접속 (앱 역할). 운영: Supabase 의 Supavisor transaction pooler(6543) URL.
# 이 역할은 요청마다 SET LOCAL ROLE authenticated / service_role 로 전환해 RLS 를 그대로 적용받는다.
DATABASE_URL=postgres://between_app:between_app@localhost:5432/between_dev
# 로컬 db-setup 스크립트 전용 (운영에는 설정하지 않음)
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres

# 인증 드라이버: supabase (운영) | local (개발/테스트, 자체 서명 익명 JWT)
AUTH_PROVIDER=local
# local 드라이버 JWT 서명키 (32자 이상 랜덤). `openssl rand -base64 48`
LOCAL_JWT_SECRET=dev-only-change-me-dev-only-change-me-0123456789

# 저장소 드라이버: supabase (운영) | local (개발/테스트, 파일시스템)
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=.data/uploads

# Supabase (AUTH_PROVIDER/STORAGE_PROVIDER=supabase 일 때 필수)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용. 클라이언트 번들에 절대 노출 금지 (NEXT_PUBLIC_ 접두어 금지)
SUPABASE_SERVICE_ROLE_KEY=

# /api/cron/cleanup 호출 인증 (Vercel Cron 은 Authorization: Bearer $CRON_SECRET 전송)
CRON_SECRET=dev-cron-secret
