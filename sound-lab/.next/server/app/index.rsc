b:["$","li","rhythm-to-pitch",{"className":"card","children":[["$","$L2",null,{"href":"/sound/rhythm-to-pitch/","children":"리듬에서 음정으로"}],["$","p",null,{"children":["클릭의 반복 속도를 올리면 초당 약 20~30회 부근에서 개별 사건의 지각(리듬)이 융합되어 하나의 음높이 지각으로 바뀐다","…"]}],["$","span",null,{"className":"meta","children":[false,false]}]]}]
c:["$","li","subjective-rhythmization",{"className":"card","children":[["$","$L2",null,{"href":"/sound/subjective-rhythmization/","children":"주관적 리듬화"}],["$","p",null,{"children":["물리적으로 완전히 균일한 클릭 열도 청자는 2개·3개·4개 묶음으로 강세를 부여해 '똑-딱'처럼 듣는 경향이 있다 (Bolton 1894)","…"]}],["$","span",null,{"className":"meta","children":[false,false]}]]}]
d:["$","section","psychoacoustics",{"children":[["$","h2",null,{"className":"section-title","children":[["$","$L2",null,{"href":"/category/psychoacoustics/","children":"심리음향"}]," ",["$","small",null,{"children":["(",10,")"]}]]}],["$","p",null,{"className":"section-sub","children":"맥놀이, 마스킹, 가청 한계 등 소리 지각의 기본 법칙 실험"}],["$","ul",null,{"className":"card-grid","children":[["$","li","two-tone-interference",{"className":"card","children":[["$","$L2",null,{"href":"/sound/two-tone-interference/","children":"두 순음의 간섭: 맥놀이에서 거칠기까지"}],["$","p",null,{"children":["주파수 차이가 약 15Hz 이하면 하나의 음이 흔들리는 맥놀이로, 15~75Hz 부근(임계대역 내)이면 거칠기로, 임계대역을 벗어나면 매끄러운 두 음으로 지각이 ","…"]}],["$","span",null,{"className":"meta","children":[false,false]}]]}],["$","li","binaural-beats",{"className":"card","children":[["$","$L2",null,{"href":"/sound/binaural-beats/","children":"바이노럴 비트"}],["$","p",null,{"children":["좌우 귀에 조금 다른 주파수를 각각 들려주면 공기 중 간섭이 없는데도 뇌간의 양이 처리 과정에서 위상차 변동이 비트로 지각된다","…"]}],["$","span",null,{"className":"meta","children":[["$","span",null,{"className":"badge badge-phones","children":"🎧 이어폰"}],false]}]]}],["$","li","masking",{"className":"card","children":[["$","$L2",null,{"href":"/sound/masking/","children":"마스킹"}],["$","p",null,{"children":["같은 임계대역 안의 잡음 에너지는 톤의 검출 문턱을 끌어올린다","…"]}],["$","span",null,{"className":"meta","children":[false,false]}]]}],["$","li","equal-loudness",{"className":"card","children":[["$","$L2",null,{"href":"/sound/equal-loudness/","children":"등청감 곡선 체험"}],["$","p",null,{"children":["같은 물리 레벨이라도 귀의 감도는 주파수마다 달라, 저음과 초고음은 1kHz보다 작게 들린다 (ISO 226 등청감 곡선)","…"]}],["$","span",null,{"className":"meta","children":[false,false]}]]}],["$","li","pitch-jnd",{"className":"card","children":[["$","$L2",null,{"href":"/sound/pitch-jnd/","children":"음높이 변별 한계"}],["$","p",null,{"children":["두 순음을 순차 제시할 때 훈련되지 않은 청자의 주파수 변별 문턱은 중음역에서 대략 0.5% 안팎이다","…"]}],["$","span",null,{"className":"meta","children":[false,false]}]]}],["$","li","hearing-range",{"className":"card","children":[["$","$L2",null,{"href":"/sound/hearing-range/","children":"가청 주파수 한계"}],["$","p",null,{"children":["인간의 가청 범위는 관례적으로 20Hz~20kHz로 표기하지만 상한은 나이에 따라 내려가고, 하한 부근은 청각과 촉각 지각이 겹친다","…"]}],["$","span",null,{"className":"meta","children":[false,["$","span",null,{"className":"badge badge-risk","children":"청력 주의"}]]}]]}],["$","li","combination-tones",{"className":"card","children":[["$","$L2",null,{"href":"/sound/combination-tones/","children":"결합음 (타르티니 음)"}],["$","p",null,{"children":["충분히 큰 두 순음 f1, f2를 동시에 들으면 와우각의 비선형성이 2f1-f2 같은 실제 신호에 없는 왜곡 성분을 만들어 낸다 (Tartini의 제3음)","…"]}],["$","span",null,{"className":"meta","children":[["$","span",null,{"className":"badge badge-phones","children":"🎧 이어폰"}],["$","span",null,{"className":"badge badge-risk","children":"청력 주의"}]]}]]}],["$","li","phase-timbre",{"className":"card","children":[["$","$L2",null,{"href":"/sound/phase-timbre/","children":"위상과 음색"}],["$","p",null,{"children":["배음들의 상대 위상을 바꾸면 파형 모양은 극적으로 달라지지만 정상 상태 음색 지각은 거의 변하지 않는다 (옴의 음향 법칙)","…"]}],["$","span",null,{"className":"meta","children":[false,false]}]]}],["$","li","tuning-temperament",{"className":"card","children":[["$","$L2",null,{"href":"/sound/tuning-temperament/","children":"평균율과 순정률"}],["$","p",null,{"children":["평균율 장3도는 순정률의 5:4보다 약 13.7센트 넓어 배음끼리 뚜렷한 맥놀이를 만든다","…"]}],["$","span",null,{"className":"meta","children":[false,false]}]]}],["$","li","gap-detection",{"className":"card","children":[["$","$L2",null,{"href":"/sound/gap-detection/","children":"시간 분해능 (간격 탐지)"}],["$","p",null,{"children":["잡음 한가운데 넣은 짧은 무음 구간을 탐지하는 문턱은 정상 청력에서 대략 2~3ms 수준이다","…"]}],["$","span",null,{"className":"meta","children":[false,false]}]]}]]}]]}]
e:["$","section","spatial",{"children":[["$","h2",null,{"className":"section-title","children":[["$","$L2",null,{"href":"/category/spatial/","children":"공간과 정위"}]," ",["$","small",null,{"children":["(",4,")"]}]]}],["$","p",null,{"className":"section-sub","children":"소리의 방향·거리 지각과 간섭 현상 실험"}],["$","ul",null,{"className":"card-grid","children":[["$","li","itd-ild",{"className":"card","children":[["$","$L2",null,{"href":"/sound/itd-ild/","children":"양이 단서: 시간차와 강도차"}],["$","p",null,{"children":["수평 방향 지각은 저주파에서는 좌우 도달 시간차(ITD, 최대 약 0.7ms), 고주파에서는 머리 그림자에 의한 강도차(ILD)가 주 단서가 된다 (duplex ","…"]}],["$","span",null,{"className":"meta","children":[["$","span",null,{"className":"badge badge-phones","children":"🎧 이어폰"}],false]}]]}],["$","li","haas-effect",{"className":"card","children":[["$","$L2",null,{"href":"/sound/haas-effect/","children":"선행음 효과"}],["$","p",null,{"children":["같은 소리가 수 ms~수십 ms 간격으로 두 방향에서 도달하면 먼저 온 소리가 방향 지각을 지배하고, 뒤따르는 소리는 울림으로 흡수된다 (precedence ef","…"]}],["$","span",null,{"className":"meta","children":[["$","span",null,{"className":"badge badge-phones","children":"🎧 이어폰"}],false]}]]}],["$","li","phase-cancellation",{"className":"card","children":[["$","$L2",null,{"href":"/sound/phase-cancellation/","children":"위상 상쇄"}],["$","p",null,{"children":["같은 주파수의 두 파동을 위상차 180°로 겹치면 상쇄간섭으로 소리가 사라진다","…"]}],["$","span",null,{"className":"meta","children":[false,false]}]]}],["$","li","doppler",{"className":"card","children":[["$","$L2",null,{"href":"/sound/doppler/","children":"도플러 효과"}],["$","p",null,{"children":["음원이 다가올 때는 파면이 압축되어 f·c/(c−v)로 높게, 멀어질 때는 낮게 들린다","…"]}],["$","span",null,{"className":"meta","children":[false,false]}]]}]]}]]}]
f:["$","section","synthesis",{"children":[["$","h2",null,{"className":"section-title","children":[["$","$L2",null,{"href":"/category/synthesis/","children":"합성"}]," ",["$","small",null,{"children":["(",9,")"]}]]}],["$","p",null,{"className":"section-sub","children":"가산·감산·FM·물리 모델 등 소리를 만드는 방법 실험"}],["$","ul",null,{"className":"card-grid","children":[["$","li","waveforms",{"className":"card","children":[["$","$L2",null,{"href":"/sound/waveforms/","children":"기본 파형과 배음"}],["$","p",null,{"children":["사인·삼각·사각·톱니파는 배음의 구성(홀수만/전부)과 감쇠 기울기가 달라 같은 음높이에서도 다른 음색으로 들린다","…"]}],["$","span",null,{"className":"meta","children":[false,false]}]]}],["$","li","additive-harmonics",{"className":"card","children":[["$","$L2",null,{"href":"/sound/additive-harmonics/","children":"가산 합성"}],["$","p",null,{"children":["푸리에 정리대로, 정수배 배음 사인파들의 진폭 분포만으로 정상 상태의 임의 음색을 만들 수 있다","…"]}],["$","span",null,{"className":"meta","children":[false,false]}]]}],["$","li","fm-synthesis",{"className":"card","children":[["$","$L2",null,{"href":"/sound/fm-synthesis/","children":"FM 합성"}],["$","p",null,{"children":["반송파의 주파수를 다른 파동으로 흔들면 변조지수에 따라 베셀 함수 분포의 측파대가 생겨 복잡한 음색이 나온다 (Chowning 1973)","…"]}],["$","span",null,{"className":"meta","children":[false,false]}]]}],["$","li","am-ringmod",{"className":"card","children":[["$","$L2",null,{"href":"/sound/am-ringmod/","children":"진폭 변조 연속체: 트레몰로에서 링 모듈레이션까지"}],["$","p",null,{"children":["진폭을 초당 수 회 흔들면 트레몰로, 20~75Hz 부근이면 거칠기, 그 이상이면 반송파 양옆의 측파대가 별도 성분으로 분리되어 들린다","…"]}],["$","span",null,{"className":"meta","children":[false,false]}]]}],["$","li","subtractive-noise",{"className":"card","children":[["$","$L2",null,{"href":"/sound/subtractive-noise/","children":"감산 합성: 필터와 공진"}],["$","p",null,{"children":["배음이 가득한 소스(잡음·톱니파)에서 필터로 깎아 음색을 만드는 방식","…"]}],["$","span",null,{"className":"meta","children":[false,false]}]]}],["$","li","karplus-strong",{"className":"card","children":[["$","$L2",null,{"href":"/sound/karplus-strong/","children":"현의 물리 모델 (카플러스-스트롱)"}],["$","p",null,{"children":["짧은 잡음을 지연선과 감쇠 필터의 피드백 고리에 넣으면 지연 시간이 결정하는 주기의 정상파가 남아 뜯은 현의 소리가 된다 (Karplus & Strong 1983","…"]}],["$","span",null,{"className":"meta","children":[false,false]}]]}],["$","li","adsr-envelope",{"className":"card","children":[["$","$L2",null,{"href":"/sound/adsr-envelope/","children":"엔벨로프와 악기 지각"}],["$","p",null,{"children":["어택 시간은 악기 동정의 핵심 단서다","…"]}],["$","span",null,{"className":"meta","children":[false,false]}]]}],["$","li","formant-vowel",{"className":"card","children":[["$","$L2",null,{"href":"/sound/formant-vowel/","children":"모음 포먼트 합성"}],["$","p",null,{"children":["모음의 정체는 성대 진동이 아니라 성도 공명(포먼트)의 위치가 결정한다","…"]}],["$","span",null,{"className":"meta","children":[false,false]}]]}],["$","li","noise-colors",{"className":"card","children":[["$","$L2",null,{"href":"/sound/noise-colors/","children":"잡음의 색"}],["$","p",null,{"children":["옥타브당 에너지 기울기가 잡음의 '색'을 결정한다","…"]}],["$","span",null,{"className":"meta","children":[false,false]}]]}]]}]]}]
10:["$","section","effects",{"children":[["$","h2",null,{"className":"section-title","children":[["$","$L2",null,{"href":"/category/effects/","children":"이펙트와 신호처리"}]," ",["$","small",null,{"children":["(",5,")"]}]]}],["$","p",null,{"className":"section-sub","children":"딜레이, 잔향, 왜곡 등 신호 처리가 지각을 바꾸는 방식 실험"}],["$","ul",null,{"className":"card-grid","children":[["$","li","delay-echo",{"className":"card","children":[["$","$L2",null,{"href":"/sound/delay-echo/","children":"딜레이와 피드백"}],["$","p",null,{"children":["약 30~50ms를 넘는 지연 반복은 별개의 메아리로 지각되고, 피드백은 반복 횟수를 결정한다","…"]}],["$","span",null,{"className":"meta","children":[false,false]}]]}],["$","li","flanger-chorus",{"className":"card","children":[["$","$L2",null,{"href":"/sound/flanger-chorus/","children":"짧은 딜레이의 두 세계: 플랜저와 코러스"}],["$","p",null,{"children":["지연을 천천히 흔들 때, 지연이 수 ms면 콤 필터의 홈이 쓸리는 음색 효과(플랜저)로, 20~30ms 부근이면 미세하게 어긋난 별도 음원(코러스)으로 지각된다","…"]}],["$","span",null,{"className":"meta","children":[false,false]}]]}],["$","li","reverb-convolution",{"className":"card","children":[["$","$L2",null,{"href":"/sound/reverb-convolution/","children":"잔향 합성"}],["$","p",null,{"children":["공간의 잔향은 무수한 반사의 합으로, 지수 감쇠하는 잡음과 통계적으로 유사하다","…"]}],["$","span",null,{"className":"meta","children":[false,false]}]]}],["$","li","distortion-waveshaping",{"className":"card","children":[["$","$L2",null,{"href":"/sound/distortion-waveshaping/","children":"왜곡과 배음 생성"}],["$","p",null,{"children":["비선형 전달함수에 사인파를 통과시키면 원래 없던 배음이 생긴다","…"]}],["$","span",null,{"className":"meta","children":[false,false]}]]}],["$","li","digital-degradation",{"className":"card","children":[["$","$L2",null,{"href":"/sound/digital-degradation/","children":"디지털 열화: 샘플레이트와 비트 심도"}],["$","p",null,{"children":["샘플레이트를 낮추면 나이키스트 한계를 넘는 성분이 저역으로 접혀 비조화 성분이 생기고(에일리어싱), 비트 심도를 낮추면 양자화 계단이 잡음으로 들린다","…"]}],["$","span",null,{"className":"meta","children":[false,false]}]]}]]}]]}]
