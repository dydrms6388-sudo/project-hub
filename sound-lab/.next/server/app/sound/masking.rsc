15:["$","ul",null,{"className":"related-grid","children":[["$","li","continuity-illusion",{"className":"card","children":[["$","$L2",null,{"href":"/sound/continuity-illusion/","children":"연속성 착청"}],["$","p",null,{"children":["톤이 끊긴 구간을 충분히 큰 잡음이 채우면, 청각계가 잡음 뒤에서 톤이 계속 이어졌다고 복원해 지각한다 (auditory in","…"]}]]}],["$","li","zwicker-tone",{"className":"card","children":[["$","$L2",null,{"href":"/sound/zwicker-tone/","children":"츠비커 톤 (잔류음)"}],["$","p",null,{"children":["스펙트럼에 홈(노치)을 판 광대역 잡음을 수 초 듣다가 갑자기 끄면, 노치 주파수 부근에서 실제로는 없는 희미한 톤이 1~2초","…"]}]]}],["$","li","noise-colors",{"className":"card","children":[["$","$L2",null,{"href":"/sound/noise-colors/","children":"잡음의 색"}],["$","p",null,{"children":["옥타브당 에너지 기울기가 잡음의 '색'을 결정한다","…"]}]]}]]}]
