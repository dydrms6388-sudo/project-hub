15:["$","ul",null,{"className":"related-grid","children":[["$","li","two-tone-interference",{"className":"card","children":[["$","$L2",null,{"href":"/sound/two-tone-interference/","children":"두 순음의 간섭: 맥놀이에서 거칠기까지"}],["$","p",null,{"children":["주파수 차이가 약 15Hz 이하면 하나의 음이 흔들리는 맥놀이로, 15~75Hz 부근(임계대역 내)이면 거칠기로, 임계대역을 ","…"]}]]}],["$","li","additive-harmonics",{"className":"card","children":[["$","$L2",null,{"href":"/sound/additive-harmonics/","children":"가산 합성"}],["$","p",null,{"children":["푸리에 정리대로, 정수배 배음 사인파들의 진폭 분포만으로 정상 상태의 임의 음색을 만들 수 있다","…"]}]]}],["$","li","pitch-jnd",{"className":"card","children":[["$","$L2",null,{"href":"/sound/pitch-jnd/","children":"음높이 변별 한계"}],["$","p",null,{"children":["두 순음을 순차 제시할 때 훈련되지 않은 청자의 주파수 변별 문턱은 중음역에서 대략 0.5% 안팎이다","…"]}]]}]]}]
