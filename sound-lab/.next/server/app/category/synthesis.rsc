5:["$","main",null,{"className":"wrap","children":[["$","p",null,{"className":"breadcrumb","children":[["$","$L2",null,{"href":"/","children":"홈"}]," › ","합성"]}],["$","h1",null,{"children":"합성"}],["$","p",null,{"className":"lead","children":"가산·감산·FM·물리 모델 등 소리를 만드는 방법 실험"}],["$","ul",null,{"className":"card-grid","children":[["$","li","waveforms",{"className":"card","children":[["$","$L2",null,{"href":"/sound/waveforms/","children":"기본 파형과 배음"}],["$","p",null,{"children":["사인·삼각·사각·톱니파는 배음의 구성(홀수만/전부)과 감쇠 기울기가 달라 같은 음높이에서도 다른 음색으로 들린다","…"]}],["$","span",null,{"className":"meta","children":[false,false,["$","span",null,{"className":"badge","children":["CPU ","저"]}]]}]]}],["$","li","additive-harmonics",{"className":"card","children":[["$","$L2",null,{"href":"/sound/additive-harmonics/","children":"가산 합성"}],["$","p",null,{"children":["푸리에 정리대로, 정수배 배음 사인파들의 진폭 분포만으로 정상 상태의 임의 음색을 만들 수 있다","…"]}],["$","span",null,{"className":"meta","children":[false,false,["$","span",null,{"className":"badge","children":["CPU ","중"]}]]}]]}],["$","li","fm-synthesis",{"className":"card","children":[["$","$L2",null,{"href":"/sound/fm-synthesis/","children":"FM 합성"}],["$","p",null,{"children":["반송파의 주파수를 다른 파동으로 흔들면 변조지수에 따라 베셀 함수 분포의 측파대가 생겨 복잡한 음색이 나온다 (Chowning 1973)","…"]}],["$","span",null,{"className":"meta","children":[false,false,["$","span",null,{"className":"badge","children":["CPU ","저"]}]]}]]}],["$","li","am-ringmod",{"className":"card","children":[["$","$L2",null,{"href":"/sound/am-ringmod/","children":"진폭 변조 연속체: 트레몰로에서 링 모듈레이션까지"}],["$","p",null,{"children":["진폭을 초당 수 회 흔들면 트레몰로, 20~75Hz 부근이면 거칠기, 그 이상이면 반송파 양옆의 측파대가 별도 성분으로 분리되어 들린다","…"]}],["$","span",null,{"className":"meta","children":[false,false,["$","span",null,{"className":"badge","children":["CPU ","저"]}]]}]]}],["$","li","subtractive-noise",{"className":"card","children":[["$","$L2",null,{"href":"/sound/subtractive-noise/","children":"감산 합성: 필터와 공진"}],["$","p",null,{"children":["배음이 가득한 소스(잡음·톱니파)에서 필터로 깎아 음색을 만드는 방식","…"]}],["$","span",null,{"className":"meta","children":[false,false,["$","span",null,{"className":"badge","children":["CPU ","저"]}]]}]]}],["$","li","karplus-strong",{"className":"card","children":[["$","$L2",null,{"href":"/sound/karplus-strong/","children":"현의 물리 모델 (카플러스-스트롱)"}],["$","p",null,{"children":["짧은 잡음을 지연선과 감쇠 필터의 피드백 고리에 넣으면 지연 시간이 결정하는 주기의 정상파가 남아 뜯은 현의 소리가 된다 (Karplus & Strong 1983)","…"]}],["$","span",null,{"className":"meta","children":[false,false,["$","span",null,{"className":"badge","children":["CPU ","중"]}]]}]]}],["$","li","adsr-envelope",{"className":"card","children":[["$","$L2",null,{"href":"/sound/adsr-envelope/","children":"엔벨로프와 악기 지각"}],["$","p",null,{"children":["어택 시간은 악기 동정의 핵심 단서다","…"]}],["$","span",null,{"className":"meta","children":[false,false,["$","span",null,{"className":"badge","children":["CPU ","저"]}]]}]]}],["$","li","formant-vowel",{"className":"card","children":[["$","$L2",null,{"href":"/sound/formant-vowel/","children":"모음 포먼트 합성"}],["$","p",null,{"children":["모음의 정체는 성대 진동이 아니라 성도 공명(포먼트)의 위치가 결정한다","…"]}],["$","span",null,{"className":"meta","children":[false,false,["$","span",null,{"className":"badge","children":["CPU ","저"]}]]}]]}],["$","li","noise-colors",{"className":"card","children":[["$","$L2",null,{"href":"/sound/noise-colors/","children":"잡음의 색"}],["$","p",null,{"children":["옥타브당 에너지 기울기가 잡음의 '색'을 결정한다","…"]}],["$","span",null,{"className":"meta","children":[false,false,["$","span",null,{"className":"badge","children":["CPU ","저"]}]]}]]}]]}]]}]
