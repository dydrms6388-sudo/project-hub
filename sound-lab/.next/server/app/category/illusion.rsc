5:["$","main",null,{"className":"wrap","children":[["$","p",null,{"className":"breadcrumb","children":[["$","$L2",null,{"href":"/","children":"홈"}]," › ","착청"]}],["$","h1",null,{"children":"착청"}],["$","p",null,{"className":"lead","children":"귀에 들어온 신호와 뇌가 지각한 소리가 어긋나는 청각 착각 실험"}],["$","ul",null,{"className":"card-grid","children":[["$","li","shepard-tone",{"className":"card","children":[["$","$L2",null,{"href":"/sound/shepard-tone/","children":"셰퍼드 무한 음계"}],["$","p",null,{"children":["옥타브 간격 성분들에 고정된 종형 스펙트럼 포락선을 씌우면 음높이의 순환 차원(chroma)만 남아 끝없이 상승·하강하는 것처럼 지각된다 (Shepard 1964).","…"]}],["$","span",null,{"className":"meta","children":[false,false,["$","span",null,{"className":"badge","children":["CPU ","중"]}]]}]]}],["$","li","risset-rhythm",{"className":"card","children":[["$","$L2",null,{"href":"/sound/risset-rhythm/","children":"리세 무한 가속 리듬"}],["$","p",null,{"children":["템포가 2배 관계인 클릭 레이어들을 교차 페이드하면 셰퍼드 음계의 리듬 판이 되어, 계속 빨라지는데 결코 빨라지지 않는 리듬이 지각된다 (Risset).","…"]}],["$","span",null,{"className":"meta","children":[false,false,["$","span",null,{"className":"badge","children":["CPU ","중"]}]]}]]}],["$","li","tritone-paradox",{"className":"card","children":[["$","$L2",null,{"href":"/sound/tritone-paradox/","children":"트라이톤 역설"}],["$","p",null,{"children":["반옥타브(트라이톤) 떨어진 셰퍼드 음 두 개를 이어 들려주면 상승으로 듣는 사람과 하강으로 듣는 사람이 갈린다","…"]}],["$","span",null,{"className":"meta","children":[false,false,["$","span",null,{"className":"badge","children":["CPU ","중"]}]]}]]}],["$","li","missing-fundamental",{"className":"card","children":[["$","$L2",null,{"href":"/sound/missing-fundamental/","children":"잃어버린 기본음"}],["$","p",null,{"children":["기본음 성분을 제거해도 남은 배음들의 간격(주기성)에서 청각계가 기본음의 피치를 복원해 낸다 (periodicity pitch).","…"]}],["$","span",null,{"className":"meta","children":[false,false,["$","span",null,{"className":"badge","children":["CPU ","저"]}]]}]]}],["$","li","continuity-illusion",{"className":"card","children":[["$","$L2",null,{"href":"/sound/continuity-illusion/","children":"연속성 착청"}],["$","p",null,{"children":["톤이 끊긴 구간을 충분히 큰 잡음이 채우면, 청각계가 잡음 뒤에서 톤이 계속 이어졌다고 복원해 지각한다 (auditory induction).","…"]}],["$","span",null,{"className":"meta","children":[false,false,["$","span",null,{"className":"badge","children":["CPU ","저"]}]]}]]}],["$","li","auditory-streaming",{"className":"card","children":[["$","$L2",null,{"href":"/sound/auditory-streaming/","children":"음류 분리 (갤로핑 리듬)"}],["$","p",null,{"children":["높은 음 A와 낮은 음 B를 ABA-ABA로 반복할 때, 주파수 간격이 좁고 느리면 한 줄기의 말발굽 리듬으로, 간격이 넓고 빠르면 두 개의 독립된 줄기로 갈라져 들린다 (van Noorden 19","…"]}],["$","span",null,{"className":"meta","children":[false,false,["$","span",null,{"className":"badge","children":["CPU ","저"]}]]}]]}],["$","li","octave-illusion",{"className":"card","children":[["$","$L2",null,{"href":"/sound/octave-illusion/","children":"옥타브 착청"}],["$","p",null,{"children":["좌우 귀에 고음과 저음을 서로 엇갈려 교대로 들려주면, 다수의 청자가 한쪽 귀에서 고음만·반대쪽에서 저음만 나는 것으로 재구성해 듣는다","…"]}],["$","span",null,{"className":"meta","children":[["$","span",null,{"className":"badge badge-phones","children":"🎧 이어폰"}],false,["$","span",null,{"className":"badge","children":["CPU ","저"]}]]}]]}],["$","li","scale-illusion",{"className":"card","children":[["$","$L2",null,{"href":"/sound/scale-illusion/","children":"음계 착청"}],["$","p",null,{"children":["상행·하행 음계를 음표 단위로 좌우 귀에 흩어 놓아도, 청각계는 귀가 아니라 주파수 근접성을 기준으로 재편성해 각 귀에서 매끄러운 선율을 지각한다 (Deutsch 1975).","…"]}],["$","span",null,{"className":"meta","children":[["$","span",null,{"className":"badge badge-phones","children":"🎧 이어폰"}],false,["$","span",null,{"className":"badge","children":["CPU ","저"]}]]}]]}],["$","li","zwicker-tone",{"className":"card","children":[["$","$L2",null,{"href":"/sound/zwicker-tone/","children":"츠비커 톤 (잔류음)"}],["$","p",null,{"children":["스펙트럼에 홈(노치)을 판 광대역 잡음을 수 초 듣다가 갑자기 끄면, 노치 주파수 부근에서 실제로는 없는 희미한 톤이 1~2초 들린다","…"]}],["$","span",null,{"className":"meta","children":[false,false,["$","span",null,{"className":"badge","children":["CPU ","저"]}]]}]]}],["$","li","repetition-pitch",{"className":"card","children":[["$","$L2",null,{"href":"/sound/repetition-pitch/","children":"반복 잡음의 피치"}],["$","p",null,{"children":["잡음에 자기 자신을 수 ms 지연시켜 더하면 스펙트럼에 빗살(comb) 구조가 생기고, 1/지연시간에 해당하는 피치가 잡음 속에서 지각된다 (repetition pitch, Bilsen).","…"]}],["$","span",null,{"className":"meta","children":[false,false,["$","span",null,{"className":"badge","children":["CPU ","저"]}]]}]]}],["$","li","rhythm-to-pitch",{"className":"card","children":[["$","$L2",null,{"href":"/sound/rhythm-to-pitch/","children":"리듬에서 음정으로"}],["$","p",null,{"children":["클릭의 반복 속도를 올리면 초당 약 20~30회 부근에서 개별 사건의 지각(리듬)이 융합되어 하나의 음높이 지각으로 바뀐다","…"]}],["$","span",null,{"className":"meta","children":[false,false,["$","span",null,{"className":"badge","children":["CPU ","저"]}]]}]]}],["$","li","subjective-rhythmization",{"className":"card","children":["$L10","$L11","$L12"]}]]}]]}]
