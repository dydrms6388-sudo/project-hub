      "inputs": [
        { "name": "sensor", "unit": "preset", "min": 0, "max": 0, "default": "full-frame" },
        { "name": "printDiagonal", "unit": "mm", "min": 100, "max": 3000, "default": 325, "note": "8×10인치 인화 대각선" },
