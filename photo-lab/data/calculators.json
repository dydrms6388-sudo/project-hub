        { "input": { "sensor": "full-frame", "mode": "d", "d": 1730 }, "expected": { "cocMm": 0.025 }, "tolerance": 0.0005, "source": "Zeiss 관례 d=1730 → 0.025mm" },
        { "input": { "sensor": "full-frame", "printDiagMm": 325.1, "viewMm": 250 }, "expected": { "cocMm": 0.0266 }, "tolerance": 0.0005, "source": "8×10인치(203×254mm) 인화·25cm 감상: 확대율 7.52배 → 0.2/7.52" },
        { "input": { "sensor": "full-frame", "printDiagMm": 727.4, "viewMm": 500 }, "expected": { "cocMm": 0.0238 }, "tolerance": 0.0005, "source": "A2(420×594mm)·50cm 감상 — 감상거리를 늘려도 확대율 증가가 우세한 사례" },
        { "input": { "sensor": "mft", "printDiagMm": 325.1, "viewMm": 250 }, "expected": { "cocMm": 0.0133 }, "tolerance": 0.0005, "source": "같은 인화 조건에서 MFT는 확대율 15배 → CoC 절반 이하" }
      ],
      "complexity": "중"
    },
    {
      "slug": "npf-rule",
      "name": "별 셔터속도 (NPF vs 500법칙)",
      "category": "astro",
      "formula": "NPF: t = (35N + 30p) / f ÷ cos(δ)  (p=화소피치 μm, δ=적위).  비교용 500법칙: t = 500/f_환산",
      "formulaSource": {
        "문헌명": "Frédéric Michaud, «Règle NPF», Société Astronomique du Havre (sahavre.fr) — 회절+화소피치+항성 이동을 결합한 간이형; 500법칙은 필름 시대 경험칙(출처 불명 관례)",
        "출처": "NPF 간이식 (35N+30p)/f. 적위 보정은 항성 각속도 ∝ cos(δ)에서 유도"
      },
      "inputs": [
        { "name": "focalLength", "unit": "mm", "min": 8, "max": 200, "default": 20 },
        { "name": "aperture", "unit": "f-number", "min": 0.95, "max": 8, "default": 2.8 },
        { "name": "pixelPitch", "unit": "μm", "min": 0.6, "max": 9, "default": 6.0, "note": "센서 프리셋+화소수에서 자동 산출" },
        { "name": "declination", "unit": "deg", "min": 0, "max": 80, "default": 0 }
      ],
      "testCases": [
        { "input": { "N": 2.8, "p": 6.0, "f": 20, "decl": 0 }, "expected": { "npfS": 13.9, "rule500S": 25.0 }, "tolerance": 0.1, "source": "FF 24MP 20mm f/2.8 — NPF 공식 대입. 500법칙과 1.8배 차이 시연" },
        { "input": { "N": 1.8, "p": 3.79, "f": 14, "decl": 0 }, "expected": { "npfS": 12.6, "rule500S": 35.7 }, "tolerance": 0.1, "source": "FF 61MP(피치 3.79μm) — 고화소에서 500법칙이 3배 가까이 과대함" },
        { "input": { "N": 2.8, "p": 6.0, "f": 20, "decl": 60 }, "expected": { "npfS": 27.8 }, "tolerance": 0.1, "source": "적위 60° → cos(60°)=0.5, 허용 시간 2배 (북극성 부근일수록 느리게 이동)" },
        { "input": { "N": 4, "p": 3.34, "f": 24, "decl": 0 }, "expected": { "npfS": 10.0 }, "tolerance": 0.1, "source": "MFT 20MP(피치 3.34μm) 24mm f/4 대입값" },
        { "input": { "N": 1.4, "p": 5.94, "f": 35, "decl": 0 }, "expected": { "npfS": 6.49 }, "tolerance": 0.05, "source": "35mm 준광각 — 초점거리 증가에 따른 급감 확인" }
      ],
      "complexity": "고"
    },
    {
      "slug": "star-trail-length",
      "name": "별 궤적 길이 계산기",
      "category": "astro",
      "formula": "각이동 = 15.041″/s × t × cos(δ);  센서상 길이 = f × (각이동″/206265) mm;  픽셀 = 길이×1000/p",
      "formulaSource": {
        "문헌명": "항성일 23h56m4.1s(86164.1s) → 항성 각속도 1,296,000″/86164.1s = 15.041″/s. 소각 근사 1 rad = 206265″. Jean Meeus, Astronomical Algorithms, 2nd ed. (1998)",
        "출처": "항성시 정의와 초점면 투영(플레이트 스케일) 기하"
      },
      "inputs": [
        { "name": "focalLength", "unit": "mm", "min": 8, "max": 800, "default": 50 },
