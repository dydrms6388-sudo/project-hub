  "calculators": [
    {
      "slug": "depth-of-field",
      "name": "심도 계산기",
      "category": "depth",
      "formula": "H = f²/(N·c) + f;  근점 Dn = s(H−f)/(H+s−2f);  원점 Df = s(H−f)/(H−s), 단 s ≥ H이면 Df = ∞",
      "formulaSource": {
        "문헌명": "Sidney F. Ray, Applied Photographic Optics, 3rd ed., Focal Press (2002), ch.22; Allen R. Greenleaf, Photographic Optics, Macmillan (1950), pp.25–27",
        "출처": "대칭 렌즈·박막렌즈 근사 기반 표준 심도 방정식. DOFMaster 등 통용 계산기와 동일 식"
      },
      "inputs": [
        { "name": "focalLength", "unit": "mm", "min": 4, "max": 1200, "default": 50 },
        { "name": "aperture", "unit": "f-number", "min": 0.95, "max": 64, "default": 8 },
        { "name": "subjectDistance", "unit": "m", "min": 0.1, "max": 3000, "default": 10 },
        { "name": "coc", "unit": "mm", "min": 0.005, "max": 0.06, "default": 0.03, "note": "센서/출력 조건에서 자동 산출, 수동 오버라이드 가능" }
      ],
      "testCases": [
        { "input": { "f": 50, "N": 8, "c": 0.03, "s": 10 }, "expected": { "nearM": 5.12, "farM": 223.2 }, "tolerance": 0.01, "source": "DOFMaster 공표값(FF 50mm f/8 10m: 5.12m/223m)과 일치. 표준 심도식 대입값" },
        { "input": { "f": 35, "N": 11, "c": 0.03, "s": 3 }, "expected": { "nearM": 1.668, "farM": 14.91 }, "tolerance": 0.01, "source": "표준 심도식 대입 (H=3.747m)" },
        { "input": { "f": 25, "N": 1.4, "c": 0.015, "s": 2 }, "expected": { "nearM": 1.876, "farM": 2.142 }, "tolerance": 0.005, "source": "MFT(c=diag/1442≈0.015) 대입값" },
        { "input": { "f": 24, "N": 11, "c": 0.03, "s": 5 }, "expected": { "nearM": 1.298, "farM": "Infinity" }, "tolerance": 0.005, "source": "s(5m) > H(1.769m) → 원점 무한대. 경계조건 검증" },
        { "input": { "f": 85, "N": 1.8, "c": 0.03, "s": 3 }, "expected": { "nearM": 2.936, "farM": 3.067 }, "tolerance": 0.005, "source": "인물 촬영 대표 조건 대입값" },
        { "input": { "f": 50, "N": 2.8, "c": 0.019, "s": 1.5 }, "expected": { "nearM": 1.455, "farM": 1.548 }, "tolerance": 0.005, "source": "APS-C(c≈0.019) 대입값" }
      ],
      "complexity": "고"
    },
    {
