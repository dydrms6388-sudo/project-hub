# ── 인프라 ──────────────────────────────
REDIS_URL=redis://127.0.0.1:6379
REDIS_PREFIX=ms:
PORT=8787
# UI/관리 API 인증 (필수). 긴 랜덤 문자열.
API_TOKEN=
# 외부 수집기 push(/api/ingest) 인증
INGEST_TOKEN=
# 감사 로그 장기 보관 파일 (선택, JSONL)
AUDIT_FILE=

# ── 탐지 (기본값 = 요구사항) ─────────────
DETECT_TICK_SEC=10
DETECT_WINDOW_SEC=60
DEFAULT_MIN_GROWTH_PCT=200
DEFAULT_MIN_COUNT=20
DEFAULT_MIN_UNIQUE_AUTHORS=8
DEFAULT_COOLDOWN_SEC=900
DEFAULT_REALERT_MULTIPLIER=2
DEFAULT_EVENT_RESET_SEC=300
FRESHNESS_MAX_LAG_SEC=90

# ── 필터 ────────────────────────────────
FILTER_MAX_PER_AUTHOR_PER_WINDOW=2
FILTER_DUP_CONTENT_TTL_SEC=600
FILTER_MAX_EVENT_AGE_SEC=300

# ── 수집 소스 ───────────────────────────
# Reddit Data API (https://www.reddit.com/prefs/apps 에서 script/web 앱 생성)
REDDIT_ENABLED=0
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=mention-spike/0.1 (by /u/your_reddit_username)
REDDIT_SUBREDDITS=CryptoCurrency,CryptoMarkets,Bitcoin
REDDIT_MAX_QPM=60
REDDIT_POLL_SEC=15
# 개발용 합성 데이터
SIMULATOR_ENABLED=0

# ── 알림 ────────────────────────────────
# @BotFather 로 만든 봇 토큰. 사용자는 봇에게 /start 후 chat id 를 설정에 입력.
TELEGRAM_BOT_TOKEN=
# 예: smtps://user:app-password@smtp.gmail.com:465
SMTP_URL=
SMTP_FROM=
NOTIFY_MAX_ATTEMPTS=5
NOTIFY_CLAIM_IDLE_MS=30000
